root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json,slint}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

# Windows PowerShell 5.1 and makensis need a BOM to read UTF-8 correctly.
# Keep .ps1 contents ASCII-only anyway.
[*.{ps1,nsi,nsh}]
charset = utf-8-bom
end_of_line = crlf

[packaging/**.txt]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

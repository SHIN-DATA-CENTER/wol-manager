// Data types shared between the Rust side and the Slint UI.
//
// Every enum/struct here is re-exported from app.slint so that slint-build generates a Rust
// type for it (Rust names: enums -> PascalCase variants, struct fields -> snake_case).
// The first variant of every enum is its Rust `Default`.

// ---------------------------------------------------------------------------------------------
// Host list

/// Reachability state of a host. Always rendered with text (never colour only).
export enum HostStatus {
    unknown,        // not checked yet (hollow grey dot)
    checking,       // probe in flight (blue, pulsing)
    online,         // last probe answered (green)
    offline,        // last probe did not answer (grey)
    waking,         // magic packet sent, waiting for the host to come up (amber, pulsing)
    timeout,        // waking gave up after verify_timeout_secs (red); kept until next answer / wake
    not-monitored,  // probe = none or no address (hollow grey dot)
    restarting,     // v0.2: restart accepted, waiting for the host to come back (amber, pulsing)
    shutting-down,  // v0.2: shutdown accepted, waiting for the host to stop answering (grey, pulsing)
}

/// How the last successful probe reached the host (shown in the status tooltip).
export enum ProbeVia { none, icmp, tcp }

/// v0.2: how a host is managed remotely (restart / shutdown / boot time / MAC lookup).
export enum RemoteKind {
    none,     // not managed (no [hosts.remote] table)
    windows,  // Windows remote management (SMB/RPC + WMI)
    ssh,      // Linux / NAS / FreeBSD over SSH
}

/// One row of the host list. Identified by `id` everywhere, never by row index.
export struct HostRow {
    id: string,         // host UUID (string form)
    name: string,
    mac: string,        // display form "AA:BB:CC:DD:EE:FF"
    address: string,    // IPv4 or host name as entered; "" = none
    group: string,      // "" = no group
    notes: string,      // single line is shown; newlines are fine but only the first line is visible
    status: HostStatus,
    via: ProbeVia,      // meaningful when status == online
    rtt-ms: int,        // round-trip time of the last successful probe, -1 = unknown
    // ---- v0.2 remote management ----
    managed: bool,          // remote management is set up (remote-kind != none)
    remote-kind: RemoteKind,
    boot-text: string,      // localized by Rust, e.g. "起動 9/29 08:12 (稼働 3 時間 12 分)"; "" = unknown / hidden
    boot-approx: bool,      // the boot time is approximate (Windows statistics were denied)
    busy-remote: bool,      // a remote operation for this host is running (menus disabled, spinner)
}

/// v0.2: kind of a network adapter found on a remote host ("Get from IP" candidates).
export enum MacKind { physical, wifi, other }

/// v0.2: one MAC address candidate of the MAC picker (sorted by score, best first).
export struct MacCandidateRow {
    iface: string,          // adapter name as reported by the host, e.g. "Ethernet" / "enp3s0"
    mac: string,            // display form "AA:BB:CC:DD:EE:FF"
    kind: MacKind,
    detail: string,         // data, e.g. "192.168.1.20/24" (LAN IPv4 of the adapter); "" = none
    default-route: bool,    // the host's default route goes through this adapter
    link-up: bool,          // cable connected / Wi-Fi associated
    score: int,             // ranking by Rust (higher = better); equal to the first row's = recommended
}

/// v0.2: SSH host key shown in the trust dialog (unknown key) or the mismatch error.
export struct HostKeyPrompt {
    host-id: string,              // host UUID ("" when the editor tests a new, unsaved host)
    host-name: string,            // data
    address: string,              // management address (IPv4 or host name)
    port: int,                    // SSH port
    key-type: string,             // e.g. "ssh-ed25519"
    fingerprint: string,          // received key, "SHA256:…"
    key-line: string,             // received key in OpenSSH form ("ssh-ed25519 AAAA…"); not shown
    mismatch: bool,               // true: the received key differs from the pinned one (hard error)
    expected-fingerprint: string, // mismatch only: the pinned key's "SHA256:…"
}

/// v0.2: restart or shut down.
export enum PowerAction { restart, shutdown }

/// v0.2: request shown in the power confirm dialog. The UI edits delay-secs / force / message.
export struct PowerRequest {
    host-id: string,
    host-name: string,      // data
    address: string,        // management address shown under the name
    action: PowerAction,
    kind: RemoteKind,       // windows: options are shown; ssh: sudo note
    delay-secs: int,        // Windows countdown 0..=600 (0 = immediately); ignored for SSH
    force: bool,            // Windows: force apps to close; ignored for SSH
    message: string,        // Windows: message shown during the countdown ("" = none); ignored for SSH
    command: string,        // SSH: the host's own command for this action, run with root rights instead of the
                            // platform default ("" = the default); read-only, always shown (data)
}

/// Entry of the tray "Wake host" submenu.
export struct TrayHost {
    id: string,
    name: string,
    status: HostStatus,
}

// ---------------------------------------------------------------------------------------------
// Notifications

export enum ToastKind { info, success, warning, error }

/// A transient notification (bottom-right). Text is produced by Rust (wol_core::i18n::Msg).
export struct Toast {
    id: int,         // unique, used by AppState.dismiss-toast(id)
    kind: ToastKind,
    text: string,    // main line
    detail: string,  // optional second line (e.g. OS error), "" = none
}

/// Persistent problems shown in the InfoBar area at the top of the main window.
export enum NoticeKind {
    config-load-failed,       // config.toml could not be parsed; nothing is written until fixed
    config-read-only,         // the storage folder is not writable; changes cannot be saved
    config-newer-version,     // schema_version is newer than supported -> opened read-only
    portable-marker-ignored,  // installed copy: wol-manager.portable next to the exe is ignored
    tray-unavailable,         // the notification-area icon could not be created
}

export struct Notice {
    kind: NoticeKind,
    detail: string,  // data shown under the message (parse error, path, OS error); may be ""
}

// ---------------------------------------------------------------------------------------------
// Overlays and dialogs

/// Which in-window overlay is open. Confirm dialogs are a separate layer (AppState.confirm-open)
/// because they can appear on top of the editor or the settings overlay.
export enum OverlayKind { none, editor, settings, about }

export enum ConfirmKind {
    delete-host,         // host-id + subject(name)
    wake-all,            // count = number of hosts that will be woken
    portable-enable,     // path = future data folder; option = "copy current settings" checkbox
    portable-disable,    // path = AppData folder that will be used again
    portable-overwrite,  // path = existing data folder; accept = overwrite, alternate = use existing
    save-as-new,         // host-id + subject(name): host was deleted externally while editing
    forget-host-key,     // v0.2: host-id + subject(name): remove the pinned SSH host key
}

export struct ConfirmRequest {
    kind: ConfirmKind,
    host-id: string,
    subject: string,  // usually the host name (data)
    count: int,
    path: string,
    option: bool,     // checkbox state (portable-enable: copy current settings), UI-editable
}

// ---------------------------------------------------------------------------------------------
// Host editor

export enum EditorMode { add, edit, duplicate }

/// Result of a field check. Mirrors wol_core::model::FieldIssue one-to-one (plus `none`).
export enum FieldIssue {
    none,
    required,
    invalid-mac,
    mac-not-unicast,
    invalid-address,
    invalid-port,
    invalid-port-list,
    too-many-ports,
    invalid-secure-on,
    invalid-target,
    duplicate-name,
    name-looks-like-mac,
    name-too-long,
    ime-kana,
    invalid-user,      // v0.2: remote user name
    invalid-command,   // v0.2: SSH power command override (not editable in the GUI; config only)
    invalid-host-key,  // v0.2: pinned SSH host key is not an OpenSSH public key (config only)
}

/// State of the "Get from IP" lookup in the editor (ARP or, v0.2, remote management).
export enum ArpStatus {
    idle,
    busy,
    found,
    not-found,
    not-local,
    failed,        // + EditorState.arp-message (Rust text, may be "")
    needs-remote,  // v0.2: not on a local subnet (e.g. VPN) and no remote management; arp-message explains
}

/// v0.2: sudo handling for SSH hosts (config `sudo`; `separate` = own sudo secret).
export enum SudoMode {
    auto,      // root: none; else try NOPASSWD, then the login password
    root,      // the login user is root, no sudo
    nopasswd,  // sudo without a password
    password,  // sudo with the login password
    separate,  // sudo with its own password (secret kind "sudo")
}

/// v0.2: "Test connection" state in the editor.
export enum TestStatus { idle, busy, ok, failed }

/// A network adapter that a host can be pinned to.
export struct InterfaceOption {
    id: string,      // adapter GUID (stored in config)
    label: string,   // adapter name, e.g. "Ethernet"
    detail: string,  // e.g. "192.168.1.20/24"
}

// ---------------------------------------------------------------------------------------------
// Settings / storage

/// Where settings are stored. `custom` = --config-dir or WOL_MANAGER_CONFIG_DIR.
export enum StorageMode { standard, portable, custom }

/// Why the portable switch is disabled.
export enum PortableBlock {
    none,             // switch is usable
    installed,        // installed copy (uninstall.exe present)
    not-writable,     // the folder next to the exe is not writable
    custom-location,  // --config-dir / WOL_MANAGER_CONFIG_DIR overrides the location
    busy,             // a migration is running
}

/// Which PATH control the "Storage & command line" page shows.
export enum PathMode {
    user,         // portable or per-user install: switch edits the user PATH
    machine,      // all-users install: system PATH status is shown read-only
    unavailable,  // wolm.exe was not found next to the app
}

export enum PathState { unknown, busy, registered, not-registered, error }

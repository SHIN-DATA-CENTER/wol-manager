// Host editor overlay (add / edit / duplicate).
//
// Field values live in EditorState (two-way). Every edit re-runs the matching Validator pure
// callback and stores the result in EditorState.*-issue; Rust validates again on save.

import { Button, LineEdit, TextEdit, CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { CoolIcons } from "@coolicons";
import {
    EditorMode, FieldIssue, ArpStatus, OverlayKind, InterfaceOption, RemoteKind, SudoMode,
    TestStatus, ToastKind,
} from "../types.slint";
import { Theme } from "../theme.slint";
import { AppState, EditorState, Validator, SettingsState, Texts } from "../state.slint";
import {
    Field, HintText, IssueText, Icon, IconButton, Divider, DropdownButton, PopupFrame, PopupItem,
    PopupListKeys, BusySpinner, InfoBar, WrapBox, DetailRow,
} from "../widgets.slint";
import { ModalFrame, ModalFooter } from "modal.slint";

/// v0.2: password field for a stored secret. Rust never sends a stored secret back: `saved`
/// only says that one exists (placeholder "Saved" + a Delete button). Empty = keep it, typed =
/// replace it. "Delete" clears the field and marks the secret for deletion on save; the field is
/// disabled until "Undo", so a typed value and the delete flag never coexist.
component SecretField inherits Field {
    in-out property <string> text;
    in property <bool> saved;
    in-out property <bool> delete;
    in property <bool> enabled: true;
    /// Placeholder while nothing is saved.
    in property <string> empty-placeholder;
    /// Accessible names of the Delete / Undo buttons, e.g. "Delete saved password" /
    /// "Keep the saved password".
    in property <string> delete-label;
    in property <string> undo-label;
    callback accepted();
    /// The typed text changed, or Delete / Undo was clicked (the draft changed).
    callback edited(text: string);

    HorizontalLayout {
        spacing: 8px;
        LineEdit {
            accessible-label: root.label;
            accessible-description: root.delete ? @tr("The saved value is deleted when you save the host. Choose Undo to keep it.")
                : root.saved ? @tr("Saved. Leave the field empty to keep it, or type a new one to replace it.")
                : "";
            enabled: root.enabled && !root.delete;
            input-type: InputType.password;
            text <=> root.text;
            placeholder-text: root.delete ? @tr("Deleted on save")
                : root.saved ? @tr("Saved")
                : root.empty-placeholder;
            edited(t) => { root.edited(t); }
            accepted => { root.accepted(); }
        }
        if root.saved : Button {
            text: root.delete ? @tr("Undo") : @tr("Delete");
            accessible-label: root.delete ? root.undo-label : root.delete-label;
            enabled: root.enabled;
            clicked => {
                if !root.delete {
                    root.text = "";
                }
                root.delete = !root.delete;
                root.edited(root.text);
            }
        }
    }
}

/// v0.2: small "i" + text note inside the remote section.
component NoteText inherits HorizontalLayout {
    in property <string> text;
    in property <image> icon: CoolIcons.info;
    in property <color> tint: Theme.info-fg;
    spacing: 8px;
    Icon {
        source: root.icon;
        size: 14px;
        tint: root.tint;
        cross-axis-self-alignment: start;
    }
    HintText {
        text: root.text;
        horizontal-stretch: 1;
    }
}

/// Adapter pinning picker: Automatic / keep the existing pinning / one adapter.
/// List positions: 0 = automatic (-1), [1 = keep (-2)], then the adapters.
component InterfacePicker inherits DropdownButton {
    property <int> index: EditorState.interface-index;
    /// The host's existing pinning can't be shown as one present adapter: offer to keep it.
    property <bool> keep-available: EditorState.interface-pinned-count > 1 || EditorState.interface-missing;
    property <int> first-adapter: root.keep-available ? 2 : 1;
    property <int> position: root.index == -2 && root.keep-available ? 1
        : root.index >= 0 && root.index < EditorState.interfaces.length ? root.index + root.first-adapter
        : 0;
    property <string> keep-text: @tr("Keep current pinning ({n} adapter)" | "Keep current pinning ({n} adapters)" % max(1, EditorState.interface-pinned-count));
    text: root.index == -2 ? root.keep-text
        : root.index >= 0 && root.index < EditorState.interfaces.length
            ? EditorState.interfaces[root.index].label + "  (" + EditorState.interfaces[root.index].detail + ")"
            : @tr("Automatic (all suitable adapters)");
    clicked => { popup.show(); }

    function choose(position: int) {
        EditorState.interface-index = position <= 0 ? -1
            : root.keep-available && position == 1 ? -2
            : position - root.first-adapter;
        popup.close();
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 280px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        forward-focus: keys;
        keys := PopupListKeys {
            count: root.first-adapter + EditorState.interfaces.length;
            current: root.position;
            choose(p) => { root.choose(p); }
            close => { popup.close(); }
            PopupFrame {
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    PopupItem {
                        text: @tr("Automatic (all suitable adapters)");
                        checked: root.index == -1;
                        highlighted: keys.current == 0;
                        clicked => { root.choose(0); }
                    }
                    if root.keep-available : PopupItem {
                        text: root.keep-text;
                        checked: root.index == -2;
                        highlighted: keys.current == 1;
                        clicked => { root.choose(1); }
                    }
                    for opt[i] in EditorState.interfaces : PopupItem {
                        text: opt.label;
                        detail: opt.detail;
                        checked: root.index == i;
                        highlighted: keys.current == i + root.first-adapter;
                        clicked => { root.choose(i + root.first-adapter); }
                    }
                }
            }
        }
    }
}

/// Clickable header of the collapsible "Advanced" section.
component ExpanderHeader inherits Rectangle {
    in property <string> title;
    in property <string> summary;
    in property <bool> enabled: true;
    in-out property <bool> expanded;
    min-height: 44px;
    border-radius: Theme.radius;
    background: ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : Theme.subtle-fill;
    border-width: 1px;
    border-color: Theme.card-border;
    forward-focus: fs;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.summary;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-default => {
        if root.enabled {
            root.expanded = !root.expanded;
        }
    }
    // Screen readers see an expandable button as expand/collapse (UIA ExpandCollapse, no
    // Invoke), so "Expand" must work too.
    accessible-action-expand => {
        if root.enabled {
            root.expanded = true;
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;
        Icon {
            source: root.expanded ? CoolIcons.chevron-down : CoolIcons.chevron-right;
            size: 16px;
            tint: Theme.text;
            cross-axis-self-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-weight: 600;
                color: Theme.text;
            }
            if !root.expanded && root.summary != "" : Text {
                text: root.summary;
                font-size: Theme.font-small;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            root.expanded = !root.expanded;
        }
    }
    fs := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.expanded = !root.expanded;
                return accept;
            }
            return reject;
        }
    }
    if fs.has-focus && root.enabled : Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Theme.text;
    }
}

export component HostEditorOverlay inherits ModalFrame {
    title: EditorState.mode == EditorMode.edit ? @tr("Edit host")
        : EditorState.mode == EditorMode.duplicate ? @tr("Duplicate host")
        : @tr("Add host");
    title-icon: EditorState.mode == EditorMode.add ? CoolIcons.add : EditorState.mode == EditorMode.duplicate ? CoolIcons.copy : CoolIcons.edit;
    card-width: 600px;

    /// The TCP ports are used by the chosen method: automatic (1), TCP (3), or the settings
    /// default (0) when that is automatic or TCP.
    property <bool> tcp-ports-used: EditorState.probe-index == 1 || EditorState.probe-index == 3
        || (EditorState.probe-index == 0 && (SettingsState.probe-method-index == 0 || SettingsState.probe-method-index == 2));

    function cancel() {
        AppState.overlay = OverlayKind.none;
        AppState.overlay-closed(OverlayKind.editor);
    }

    function validate-all() {
        EditorState.name-issue = Validator.check-name(EditorState.name, EditorState.host-id);
        EditorState.mac-issue = Validator.check-mac(EditorState.mac);
        EditorState.address-issue = Validator.check-address(EditorState.address);
        EditorState.targets-issue = Validator.check-targets(EditorState.targets);
        EditorState.port-issue = Validator.check-port(EditorState.port);
        EditorState.secureon-issue = Validator.check-secureon(EditorState.secureon);
        EditorState.tcp-ports-issue = Validator.check-tcp-ports(EditorState.tcp-ports);
        if EditorState.targets-issue != FieldIssue.none || EditorState.port-issue != FieldIssue.none
            || EditorState.secureon-issue != FieldIssue.none || EditorState.tcp-ports-issue != FieldIssue.none {
            EditorState.advanced-open = true;
        }
        // v0.2: remote fields only count while remote management is on.
        if EditorState.remote-kind == RemoteKind.none {
            EditorState.remote-address-issue = FieldIssue.none;
            EditorState.remote-user-issue = FieldIssue.none;
            EditorState.ssh-port-issue = FieldIssue.none;
        } else {
            EditorState.remote-address-issue = Validator.check-address(EditorState.remote-address);
            EditorState.remote-user-issue = Validator.check-remote-user(EditorState.remote-user, EditorState.remote-kind);
            EditorState.ssh-port-issue = EditorState.remote-kind == RemoteKind.ssh ? Validator.check-port(EditorState.ssh-port) : FieldIssue.none;
            if EditorState.remote-address-issue != FieldIssue.none || EditorState.remote-user-issue != FieldIssue.none
                || EditorState.ssh-port-issue != FieldIssue.none {
                EditorState.remote-open = true;
            }
        }
    }

    function save() {
        if EditorState.saving || !root.interactive {
            return;
        }
        root.validate-all();
        EditorState.save();
    }

    /// v0.2: a remote field changed: an earlier "Test connection" result no longer applies.
    function remote-edited() {
        if EditorState.test-status != TestStatus.busy {
            EditorState.test-status = TestStatus.idle;
        }
    }

    /// v0.2: "Set up remote management" (VPN notice): expand the section and scroll to it.
    function reveal-remote() {
        EditorState.remote-open = true;
        remote-header.focus();
        // Scroll once the new section is laid out (next timer tick).
        root.reveal-pending = true;
    }
    property <bool> reveal-pending;
    Timer {
        interval: 20ms;
        running: root.reveal-pending;
        triggered => {
            root.reveal-pending = false;
            sv.content-y = max(sv.visible-height - content.preferred-height, 8px - remote-header.y);
        }
    }

    /// v0.2: something of the host's remote management is stored outside the draft fields
    /// (Credential Manager secrets, pinned host key); kind None removes it on save.
    property <bool> has-remote-secrets: EditorState.remote-password-saved || EditorState.ssh-key-passphrase-saved
        || EditorState.ssh-sudo-password-saved || EditorState.host-key-fingerprint != "";

    /// v0.2: "Get from IP" works for an IPv4 address (ARP) or through remote management.
    property <bool> lookup-possible: Validator.is-ipv4(EditorState.address)
        || (EditorState.remote-kind != RemoteKind.none && (EditorState.address != "" || EditorState.remote-address != ""));

    // v0.2: after a choice in the MAC picker the focus goes back to the MAC field.
    property <bool> picker-open: EditorState.mac-picker-open;
    property <bool> refocus-mac;
    changed picker-open => {
        if !self.picker-open {
            root.refocus-mac = true;
            mac-edit.focus();
        }
    }
    focus-restored => {
        if root.refocus-mac {
            root.refocus-mac = false;
            mac-edit.focus();
        }
    }

    close-requested => { root.cancel(); }
    init => {
        // "Set up remote management…" (AppState.setup-remote) opens the editor with the section
        // expanded for an unmanaged host: show the section instead of the name field, which
        // would leave it below the fold. Any other opening starts at the name.
        if EditorState.remote-open && EditorState.remote-kind == RemoteKind.none {
            root.reveal-remote();
        } else {
            name-edit.focus();
        }
    }

    sv := ScrollView {
        vertical-stretch: 1;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        // The fluent ScrollView does not forward its content size; the card sizes to it.
        preferred-height: content.preferred-height;

        content := VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 6px;
            padding-bottom: 18px;
            spacing: 14px;
            alignment: start;

            // Every control takes its accessible label from its Field (screen readers would
            // otherwise announce the placeholder or nothing). Every control is disabled while
            // the confirm dialog is open above the editor (root.interactive), so that Tab can't
            // reach it.
            name-field := Field {
                label: @tr("Name");
                required: true;
                issue: EditorState.name-issue;
                name-edit := LineEdit {
                    accessible-label: name-field.label;
                    enabled: root.interactive;
                    text <=> EditorState.name;
                    placeholder-text: @tr("e.g. Office PC");
                    edited(text) => { EditorState.name-issue = Validator.check-name(text, EditorState.host-id); }
                    accepted => { root.save(); }
                }
            }

            mac-field := Field {
                label: @tr("MAC address");
                required: true;
                issue: EditorState.mac-issue;
                hint: EditorState.arp-status == ArpStatus.found ? @tr("Found the MAC address of this IP address.") : "";
                HorizontalLayout {
                    spacing: 8px;
                    mac-edit := LineEdit {
                        accessible-label: mac-field.label;
                        enabled: root.interactive;
                        text <=> EditorState.mac;
                        font-family: Theme.mono-font;
                        input-type: InputType.text;
                        placeholder-text: "AA:BB:CC:DD:EE:FF";
                        edited(text) => { EditorState.mac-issue = Validator.check-mac(text); }
                        accepted => { root.save(); }
                    }
                    Button {
                        text: @tr("Get from IP");
                        icon: CoolIcons.search;
                        colorize-icon: true;
                        enabled: root.interactive && EditorState.arp-status != ArpStatus.busy && root.lookup-possible;
                        clicked => { EditorState.lookup-mac(EditorState.address); }
                    }
                    if EditorState.arp-status == ArpStatus.busy : BusySpinner {
                        width: 20px;
                        height: 20px;
                        cross-axis-self-alignment: center;
                    }
                }
                if EditorState.arp-status == ArpStatus.not-found : IssueText {
                    text: @tr("No device answered at this IP address. Make sure it is on and try again.");
                }
                if EditorState.arp-status == ArpStatus.not-local : IssueText {
                    text: @tr("“Get from IP” only works for addresses in a local subnet of this PC.");
                }
                // v0.2: remote lookups can fail with a (long) Rust message.
                if EditorState.arp-status == ArpStatus.failed : WrapBox {
                    IssueText {
                        text: EditorState.arp-message != "" ? EditorState.arp-message : @tr("The MAC address could not be looked up.");
                    }
                }
                // v0.2: VPN / routed address without remote management (text from Rust).
                if EditorState.arp-status == ArpStatus.needs-remote : WrapBox {
                    InfoBar {
                        severity: ToastKind.info;
                        title: @tr("The MAC address can't be looked up with ARP");
                        message: EditorState.arp-message;
                        action-text: EditorState.remote-kind == RemoteKind.none ? @tr("Set up remote management") : "";
                        closable: false;
                        enabled: root.interactive;
                        action => { root.reveal-remote(); }
                    }
                }
            }

            address-field := Field {
                label: @tr("Address");
                issue: EditorState.address-issue;
                hint: @tr("IPv4 address or host name. Used for status checks and “Get from IP”.");
                LineEdit {
                    accessible-label: address-field.label;
                    enabled: root.interactive;
                    text <=> EditorState.address;
                    input-type: InputType.text;
                    placeholder-text: @tr("e.g. 192.168.1.10 or nas.local");
                    edited(text) => { EditorState.address-issue = Validator.check-address(text); }
                    accepted => { root.save(); }
                }
            }

            group-field := Field {
                label: @tr("Group");
                group-row := HorizontalLayout {
                    spacing: 4px;
                    group-edit := LineEdit {
                        accessible-label: group-field.label;
                        enabled: root.interactive;
                        text <=> EditorState.group;
                        placeholder-text: @tr("None");
                        accepted => { root.save(); }
                        // Alt+Down opens the suggestions, like a combo box.
                        key-pressed(event) => {
                            if event.modifiers.alt && event.text == Key.DownArrow && AppState.groups.length > 0 {
                                group-popup.show();
                                return accept;
                            }
                            return reject;
                        }
                    }
                    IconButton {
                        icon: CoolIcons.chevron-down;
                        tooltip: @tr("Choose an existing group");
                        enabled: root.interactive && AppState.groups.length > 0;
                        cross-axis-self-alignment: center;
                        clicked => { group-popup.show(); }
                    }
                }
                group-popup := PopupWindow {
                    x: 0;
                    y: group-row.y + group-row.height + 4px;
                    width: max(group-edit.width, 200px);
                    close-policy: PopupClosePolicy.close-on-click-outside;
                    forward-focus: group-keys;
                    group-keys := PopupListKeys {
                        count: AppState.groups.length;
                        // The item of the current group moves it there in its init.
                        current: 0;
                        choose(i) => {
                            EditorState.group = AppState.groups[i];
                            group-popup.close();
                        }
                        close => { group-popup.close(); }
                        PopupFrame {
                            VerticalLayout {
                                padding: 4px;
                                spacing: 2px;
                                for g[i] in AppState.groups : PopupItem {
                                    text: g;
                                    checked: EditorState.group == g;
                                    highlighted: group-keys.current == i;
                                    clicked => {
                                        EditorState.group = g;
                                        group-popup.close();
                                    }
                                    init => {
                                        if self.checked {
                                            group-keys.current = i;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            notes-field := Field {
                label: @tr("Notes");
                LineEdit {
                    accessible-label: notes-field.label;
                    enabled: root.interactive;
                    text <=> EditorState.notes;
                    placeholder-text: @tr("Optional");
                    accepted => { root.save(); }
                }
            }

            // ---- v0.2: remote management ------------------------------------------------------
            remote-header := ExpanderHeader {
                title: @tr("Remote management");
                summary: EditorState.remote-kind == RemoteKind.none
                    ? @tr("Restart, shut down and boot time over Windows remote management or SSH")
                    : Texts.remote-kind(EditorState.remote-kind) + "  ·  "
                        + (EditorState.remote-user != "" ? EditorState.remote-user + " @ " : "")
                        + (EditorState.remote-address != "" ? EditorState.remote-address : EditorState.address);
                enabled: root.interactive;
                expanded <=> EditorState.remote-open;
            }

            if EditorState.remote-open : WrapBox {
                spacing: 14px;

                HorizontalLayout {
                    spacing: 12px;
                    kind-field := Field {
                        width: 190px;
                        label: @tr("Type");
                        ComboBox {
                            accessible-label: kind-field.label;
                            enabled: root.interactive;
                            model: [@tr("None"), @tr("Windows"), @tr("Linux (SSH)")];
                            current-index: EditorState.remote-kind == RemoteKind.windows ? 1 : EditorState.remote-kind == RemoteKind.ssh ? 2 : 0;
                            selected => {
                                EditorState.remote-kind = self.current-index == 1 ? RemoteKind.windows : self.current-index == 2 ? RemoteKind.ssh : RemoteKind.none;
                                EditorState.remote-user-issue = EditorState.remote-kind == RemoteKind.none ? FieldIssue.none
                                    : Validator.check-remote-user(EditorState.remote-user, EditorState.remote-kind);
                                root.remote-edited();
                            }
                        }
                    }
                    if EditorState.remote-kind != RemoteKind.none : remote-address-field := Field {
                        horizontal-stretch: 1;
                        label: @tr("Management address");
                        issue: EditorState.remote-address-issue;
                        LineEdit {
                            accessible-label: remote-address-field.label;
                            enabled: root.interactive;
                            text <=> EditorState.remote-address;
                            input-type: InputType.text;
                            // "" = the host's address.
                            placeholder-text: EditorState.address != "" ? EditorState.address : @tr("Same as Address");
                            edited(text) => {
                                EditorState.remote-address-issue = Validator.check-address(text);
                                root.remote-edited();
                            }
                            accepted => { root.save(); }
                        }
                    }
                }

                if EditorState.remote-kind == RemoteKind.none : WrapBox {
                    NoteText {
                        text: @tr("With remote management, WoL Manager can restart and shut down this host, show when it was started, and find its MAC address even over a VPN.");
                    }
                }
                // Switching a managed host to "None" deletes its secrets on save: say so.
                if EditorState.remote-kind == RemoteKind.none && root.has-remote-secrets : WrapBox {
                    NoteText {
                        icon: CoolIcons.warning;
                        tint: Theme.warning-fg;
                        text: @tr("When you save, the remote management settings of this host are removed, including its saved passwords and its trusted host key.");
                    }
                }

                if EditorState.remote-kind != RemoteKind.none : HorizontalLayout {
                    spacing: 12px;
                    user-field := Field {
                        horizontal-stretch: 1;
                        label: @tr("User name");
                        issue: EditorState.remote-user-issue;
                        LineEdit {
                            accessible-label: user-field.label;
                            enabled: root.interactive;
                            text <=> EditorState.remote-user;
                            input-type: InputType.text;
                            placeholder-text: EditorState.remote-kind == RemoteKind.ssh ? "root" : @tr("Current Windows user");
                            edited(text) => {
                                EditorState.remote-user-issue = Validator.check-remote-user(text, EditorState.remote-kind);
                                root.remote-edited();
                            }
                            accepted => { root.save(); }
                        }
                    }
                    SecretField {
                        horizontal-stretch: 1;
                        label: @tr("Password");
                        enabled: root.interactive;
                        text <=> EditorState.remote-password;
                        saved: EditorState.remote-password-saved;
                        delete <=> EditorState.remote-password-delete;
                        empty-placeholder: EditorState.remote-kind == RemoteKind.ssh && EditorState.ssh-key-file != "" ? @tr("Not needed with a key file") : @tr("Not saved");
                        delete-label: @tr("Delete saved password");
                        undo-label: @tr("Keep the saved password");
                        edited => { root.remote-edited(); }
                        accepted => { root.save(); }
                    }
                }

                if EditorState.remote-kind == RemoteKind.ssh : WrapBox {
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 12px;
                        ssh-port-field := Field {
                            width: 150px;
                            label: @tr("Port");
                            issue: EditorState.ssh-port-issue;
                            LineEdit {
                                accessible-label: ssh-port-field.label;
                                enabled: root.interactive;
                                min-width: 90px;
                                text <=> EditorState.ssh-port;
                                input-type: InputType.text;
                                placeholder-text: "22";
                                edited(text) => {
                                    EditorState.ssh-port-issue = Validator.check-port(text);
                                    root.remote-edited();
                                }
                                accepted => { root.save(); }
                            }
                        }
                        key-file-field := Field {
                            horizontal-stretch: 1;
                            label: @tr("Private key file");
                            LineEdit {
                                accessible-label: key-file-field.label;
                                enabled: root.interactive;
                                text <=> EditorState.ssh-key-file;
                                input-type: InputType.text;
                                placeholder-text: @tr("Optional, e.g. C:\\Users\\me\\.ssh\\id_ed25519");
                                edited => { root.remote-edited(); }
                                accepted => { root.save(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        SecretField {
                            horizontal-stretch: 1;
                            label: @tr("Key passphrase");
                            enabled: root.interactive && (EditorState.ssh-key-file != "" || EditorState.ssh-key-passphrase-saved);
                            text <=> EditorState.ssh-key-passphrase;
                            saved: EditorState.ssh-key-passphrase-saved;
                            delete <=> EditorState.ssh-key-passphrase-delete;
                            empty-placeholder: EditorState.ssh-key-file != "" ? @tr("None") : @tr("Only with a key file");
                            delete-label: @tr("Delete saved passphrase");
                            undo-label: @tr("Keep the saved passphrase");
                            edited => { root.remote-edited(); }
                            accepted => { root.save(); }
                        }
                        sudo-field := Field {
                            horizontal-stretch: 1;
                            label: @tr("Administrator rights (sudo)");
                            ComboBox {
                                accessible-label: sudo-field.label;
                                enabled: root.interactive;
                                model: [
                                    @tr("Automatic"),
                                    @tr("Log in as root (no sudo)"),
                                    @tr("sudo without a password (NOPASSWD)"),
                                    @tr("sudo with the login password"),
                                    @tr("sudo with a separate password"),
                                ];
                                current-index: EditorState.ssh-sudo == SudoMode.root ? 1
                                    : EditorState.ssh-sudo == SudoMode.nopasswd ? 2
                                    : EditorState.ssh-sudo == SudoMode.password ? 3
                                    : EditorState.ssh-sudo == SudoMode.separate ? 4
                                    : 0;
                                selected => {
                                    EditorState.ssh-sudo = self.current-index == 1 ? SudoMode.root
                                        : self.current-index == 2 ? SudoMode.nopasswd
                                        : self.current-index == 3 ? SudoMode.password
                                        : self.current-index == 4 ? SudoMode.separate
                                        : SudoMode.auto;
                                    root.remote-edited();
                                }
                            }
                        }
                    }
                    // The methods that never use it (root, NOPASSWD, login password) delete a saved
                    // separate sudo password on save; "automatic" uses a saved one and keeps it.
                    if EditorState.ssh-sudo != SudoMode.separate && EditorState.ssh-sudo != SudoMode.auto
                        && EditorState.ssh-sudo-password-saved : WrapBox {
                        NoteText {
                            icon: CoolIcons.warning;
                            tint: Theme.warning-fg;
                            text: @tr("The saved sudo password is deleted when you save, because this sudo method doesn't use it.");
                        }
                    }
                    if EditorState.ssh-sudo == SudoMode.separate : SecretField {
                        label: @tr("sudo password");
                        enabled: root.interactive;
                        text <=> EditorState.ssh-sudo-password;
                        saved: EditorState.ssh-sudo-password-saved;
                        delete <=> EditorState.ssh-sudo-password-delete;
                        empty-placeholder: @tr("Not saved");
                        delete-label: @tr("Delete saved sudo password");
                        undo-label: @tr("Keep the saved sudo password");
                        edited => { root.remote-edited(); }
                        accepted => { root.save(); }
                    }

                    // Pinned host key (trust on first use).
                    host-key-field := Field {
                        label: @tr("Host key");
                        Rectangle {
                            background: Theme.subtle-fill;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.card-border;
                            accessible-role: groupbox;
                            accessible-label: host-key-field.label;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 10px;
                                Icon {
                                    source: EditorState.host-key-fingerprint != "" && !EditorState.host-key-forget ? CoolIcons.shield : CoolIcons.lock;
                                    size: 18px;
                                    tint: EditorState.host-key-fingerprint != "" && !EditorState.host-key-forget ? Theme.success-fg : Theme.text-secondary;
                                    cross-axis-self-alignment: center;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    if EditorState.host-key-fingerprint != "" : Text {
                                        text: EditorState.host-key-type;
                                        color: EditorState.host-key-forget ? Theme.text-tertiary : Theme.text;
                                        font-size: Theme.font-small;
                                    }
                                    if EditorState.host-key-fingerprint != "" : Text {
                                        text: EditorState.host-key-fingerprint;
                                        font-family: Theme.mono-font;
                                        font-size: 12px;
                                        color: EditorState.host-key-forget ? Theme.text-tertiary : Theme.text;
                                        wrap: char-wrap;
                                    }
                                    if EditorState.host-key-fingerprint != "" && EditorState.host-key-forget : WrapBox {
                                        Text {
                                            text: @tr("This key will be forgotten when you save.");
                                            font-size: Theme.font-small;
                                            color: Theme.warning-fg;
                                            wrap: word-wrap;
                                        }
                                    }
                                    if EditorState.host-key-fingerprint == "" : WrapBox {
                                        Text {
                                            text: @tr("Not trusted yet. On the first connection you check the fingerprint and decide whether to trust it.");
                                            font-size: Theme.font-small;
                                            color: Theme.text-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                if EditorState.host-key-fingerprint != "" : Button {
                                    text: EditorState.host-key-forget ? @tr("Undo") : @tr("Forget");
                                    accessible-label: EditorState.host-key-forget ? @tr("Keep the trusted host key") : @tr("Forget the trusted host key");
                                    enabled: root.interactive;
                                    cross-axis-self-alignment: center;
                                    clicked => {
                                        EditorState.host-key-forget = !EditorState.host-key-forget;
                                        root.remote-edited();
                                    }
                                }
                            }
                        }
                    }

                    // The host's own restart / shutdown commands (they run as root instead of the
                    // platform's, so they are always visible; read-only, set with wolm).
                    // (WrapBox: conditional content with wrapped text, see widgets.slint.)
                    if EditorState.reboot-command != "" || EditorState.shutdown-command != "" : WrapBox {
                        power-commands-field := Field {
                            label: @tr("Own restart / shutdown commands");
                            Rectangle {
                                background: EditorState.power-commands-reset ? Theme.subtle-fill : Theme.warning-bg;
                                border-radius: Theme.radius;
                                border-width: 1px;
                                border-color: Theme.card-border;
                                accessible-role: groupbox;
                                accessible-label: power-commands-field.label;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 8px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 10px;
                                    Icon {
                                        source: CoolIcons.warning;
                                        size: 18px;
                                        tint: EditorState.power-commands-reset ? Theme.text-secondary : Theme.warning-fg;
                                        cross-axis-self-alignment: start;
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 4px;
                                        if EditorState.reboot-command != "" : DetailRow {
                                            label: @tr("Restart");
                                            value: EditorState.reboot-command;
                                            mono: true;
                                            label-width: 90px;
                                            value-color: EditorState.power-commands-reset ? Theme.text-tertiary : Theme.text;
                                        }
                                        if EditorState.shutdown-command != "" : DetailRow {
                                            label: @tr("Shut down");
                                            value: EditorState.shutdown-command;
                                            mono: true;
                                            label-width: 90px;
                                            value-color: EditorState.power-commands-reset ? Theme.text-tertiary : Theme.text;
                                        }
                                        WrapBox {
                                            Text {
                                                text: EditorState.power-commands-reset
                                                    ? @tr("The platform's default commands are used again when you save.")
                                                    : @tr("These run with root rights instead of the platform's commands. They can only be changed with wolm remote set.");
                                                font-size: Theme.font-small;
                                                color: EditorState.power-commands-reset ? Theme.warning-fg : Theme.text-secondary;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                    Button {
                                        text: EditorState.power-commands-reset ? @tr("Undo") : @tr("Use the defaults");
                                        accessible-label: EditorState.power-commands-reset ? @tr("Keep the host's own commands") : @tr("Use the platform's default commands");
                                        enabled: root.interactive;
                                        cross-axis-self-alignment: center;
                                        clicked => {
                                            EditorState.power-commands-reset = !EditorState.power-commands-reset;
                                            root.remote-edited();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if EditorState.remote-kind == RemoteKind.windows : WrapBox {
                    NoteText {
                        text: @tr("Use an administrator account of that PC. It must allow File and Printer Sharing (SMB) from this PC, also over a VPN. For local accounts, Windows may deny remote administration (UAC remote restrictions). See the README for the setup.");
                    }
                }
                if EditorState.remote-kind == RemoteKind.ssh : WrapBox {
                    NoteText {
                        text: @tr("Log in as root or as a user who can use sudo. Restarting and shutting down need root rights.");
                    }
                }
                if EditorState.remote-kind != RemoteKind.none : WrapBox {
                    NoteText {
                        icon: CoolIcons.lock;
                        tint: Theme.text-secondary;
                        text: @tr("Passwords are saved in Windows Credential Manager when you save the host, never in config.toml. Leave a saved password empty to keep it.");
                    }
                }

                // Test connection + result.
                if EditorState.remote-kind != RemoteKind.none : WrapBox {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Button {
                            text: @tr("Test connection");
                            icon: CoolIcons.link;
                            colorize-icon: true;
                            enabled: root.interactive && EditorState.test-status != TestStatus.busy
                                && (EditorState.address != "" || EditorState.remote-address != "");
                            clicked => { EditorState.test-connection(); }
                        }
                        if EditorState.test-status == TestStatus.busy : BusySpinner {
                            width: 20px;
                            height: 20px;
                            cross-axis-self-alignment: center;
                        }
                        if EditorState.test-status == TestStatus.busy : Text {
                            text: @tr("Connecting…");
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                    if EditorState.test-status == TestStatus.ok : WrapBox {
                        Rectangle {
                            background: Theme.success-bg;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.card-border;
                            accessible-role: groupbox;
                            accessible-label: @tr("Connected");
                            HorizontalLayout {
                                padding: 10px;
                                padding-left: 12px;
                                spacing: 10px;
                                Icon {
                                    source: CoolIcons.ok;
                                    size: 18px;
                                    tint: Theme.success-fg;
                                    cross-axis-self-alignment: start;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: EditorState.test-os != "" ? @tr("Connected: {0}", EditorState.test-os) : @tr("Connected");
                                        font-weight: 600;
                                        color: Theme.text;
                                        wrap: word-wrap;
                                    }
                                    if EditorState.test-boot != "" : WrapBox {
                                        Text {
                                            text: EditorState.test-boot;
                                            font-size: Theme.font-small;
                                            color: Theme.text;
                                            wrap: word-wrap;
                                        }
                                    }
                                    if EditorState.test-note != "" : WrapBox {
                                        HorizontalLayout {
                                            spacing: 6px;
                                            padding-top: 2px;
                                            Icon {
                                                source: CoolIcons.warning;
                                                size: 14px;
                                                tint: Theme.warning-fg;
                                                cross-axis-self-alignment: start;
                                            }
                                            Text {
                                                text: EditorState.test-note;
                                                font-size: Theme.font-small;
                                                color: Theme.text;
                                                wrap: word-wrap;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if EditorState.test-status == TestStatus.failed : WrapBox {
                        IssueText {
                            text: EditorState.test-error != "" ? EditorState.test-error : @tr("The connection failed.");
                        }
                    }
                }
            }

            ExpanderHeader {
                title: @tr("Advanced settings");
                summary: @tr("Broadcast, extra targets, port, network adapter, SecureOn, status check");
                enabled: root.interactive;
                expanded <=> EditorState.advanced-open;
            }

            if EditorState.advanced-open : VerticalLayout {
                spacing: 14px;

                CheckBox {
                    text: @tr("Send to the broadcast address of each network adapter");
                    enabled: root.interactive;
                    checked <=> EditorState.broadcast;
                }

                targets-field := Field {
                    label: @tr("Additional targets");
                    issue: EditorState.targets-issue;
                    hint: @tr("One per line, e.g. 192.168.20.255 or wol-relay.example.lan:9. Needed for other subnets.");
                    TextEdit {
                        accessible-label: targets-field.label;
                        enabled: root.interactive;
                        height: 64px;
                        text <=> EditorState.targets;
                        font-family: Theme.mono-font;
                        wrap: no-wrap;
                        edited(text) => { EditorState.targets-issue = Validator.check-targets(text); }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    port-field := Field {
                        width: 150px;
                        label: @tr("Port");
                        issue: EditorState.port-issue;
                        LineEdit {
                            accessible-label: port-field.label;
                            enabled: root.interactive;
                            min-width: 100px;
                            text <=> EditorState.port;
                            input-type: InputType.text;
                            placeholder-text: @tr("Default ({0})", SettingsState.default-port);
                            edited(text) => { EditorState.port-issue = Validator.check-port(text); }
                            accepted => { root.save(); }
                        }
                    }
                    adapter-field := Field {
                        horizontal-stretch: 1;
                        label: @tr("Network adapter");
                        InterfacePicker {
                            accessible-label: adapter-field.label;
                            enabled: root.interactive;
                        }
                        if EditorState.interface-missing && EditorState.interface-index == -2 : IssueText {
                            text: @tr("A pinned adapter is not present on this PC. No packet is sent through it.");
                        }
                    }
                }

                secureon-field := Field {
                    label: @tr("SecureOn password");
                    issue: EditorState.secureon-issue;
                    HorizontalLayout {
                        spacing: 8px;
                        Icon {
                            source: CoolIcons.lock;
                            size: 16px;
                            tint: Theme.text-secondary;
                            cross-axis-self-alignment: center;
                        }
                        LineEdit {
                            accessible-label: secureon-field.label;
                            enabled: root.interactive;
                            text <=> EditorState.secureon;
                            font-family: Theme.mono-font;
                            input-type: InputType.text;
                            placeholder-text: @tr("Not used");
                            edited(text) => { EditorState.secureon-issue = Validator.check-secureon(text); }
                            accepted => { root.save(); }
                        }
                    }
                    if EditorState.secureon-issue == FieldIssue.none : HorizontalLayout {
                        spacing: 6px;
                        Icon {
                            source: CoolIcons.info;
                            size: 14px;
                            tint: Theme.warning-fg;
                            cross-axis-self-alignment: start;
                        }
                        HintText {
                            text: @tr("Saved as plain text in config.toml. Only needed if the network card requires it.");
                            horizontal-stretch: 1;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    probe-field := Field {
                        horizontal-stretch: 1;
                        label: @tr("Status check");
                        ComboBox {
                            accessible-label: probe-field.label;
                            enabled: root.interactive;
                            // The first entry names the current default (Settings > Wake & status).
                            model: [
                                @tr("Default ({0})", Texts.probe-method(SettingsState.probe-method-index)),
                                @tr("Automatic (ping, then TCP)"),
                                @tr("Ping (ICMP)"),
                                @tr("TCP port"),
                                @tr("Don't check"),
                            ];
                            current-index <=> EditorState.probe-index;
                        }
                    }
                    tcp-field := Field {
                        horizontal-stretch: 1;
                        label: @tr("TCP ports");
                        issue: EditorState.tcp-ports-issue;
                        LineEdit {
                            accessible-label: tcp-field.label;
                            min-width: 100px;
                            enabled: root.interactive && root.tcp-ports-used;
                            text <=> EditorState.tcp-ports;
                            input-type: InputType.text;
                            // "" = the default ports of Settings > Wake & status.
                            placeholder-text: SettingsState.probe-tcp-ports != "" ? @tr("Default ({0})", SettingsState.probe-tcp-ports) : @tr("None");
                            edited(text) => { EditorState.tcp-ports-issue = Validator.check-tcp-ports(text); }
                            accepted => { root.save(); }
                        }
                    }
                }
            }
        }
    }

    ModalFooter {
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: @tr("Save");
            primary: true;
            enabled: root.interactive && !EditorState.saving;
            min-width: 96px;
            clicked => { root.save(); }
        }
        Button {
            text: @tr("Cancel");
            enabled: root.interactive;
            min-width: 96px;
            clicked => { root.cancel(); }
        }
    }
}

// Confirm dialog (layer above every overlay). Texts are chosen from ConfirmKind with @tr;
// Rust only passes data (name, count, path).

import { Button, CheckBox } from "std-widgets.slint";
import { CoolIcons } from "@coolicons";
import { ConfirmKind, ConfirmRequest } from "../types.slint";
import { Theme } from "../theme.slint";
import { AppState } from "../state.slint";
import { CodeChip, HintText } from "../widgets.slint";
import { ModalFrame, ModalFooter } from "modal.slint";

export component ConfirmOverlay inherits ModalFrame {
    property <ConfirmRequest> req: AppState.confirm;
    property <ConfirmKind> kind: root.req.kind;

    title: root.kind == ConfirmKind.delete-host ? @tr("Delete host?")
        : root.kind == ConfirmKind.wake-all ? @tr("Wake all visible hosts?")
        : root.kind == ConfirmKind.portable-enable ? @tr("Switch to portable mode?")
        : root.kind == ConfirmKind.portable-disable ? @tr("Turn off portable mode?")
        : root.kind == ConfirmKind.portable-overwrite ? @tr("Replace the existing data folder?")
        : root.kind == ConfirmKind.forget-host-key ? @tr("Forget the trusted host key?")
        : @tr("Save as a new host?");
    title-icon: root.kind == ConfirmKind.delete-host ? CoolIcons.trash
        : root.kind == ConfirmKind.wake-all ? CoolIcons.wake
        : root.kind == ConfirmKind.save-as-new ? CoolIcons.help
        : root.kind == ConfirmKind.forget-host-key ? CoolIcons.shield-warning
        : CoolIcons.folder;
    card-width: 460px;
    show-close-button: false;
    top-layer: true;

    property <string> message: root.kind == ConfirmKind.delete-host ? @tr("“{0}” will be removed from the list. This can't be undone.", root.req.subject)
        : root.kind == ConfirmKind.wake-all ? @tr("A magic packet will be sent to {n} host that is shown in the list." | "Magic packets will be sent to the {n} hosts that are shown in the list." % root.req.count)
        : root.kind == ConfirmKind.portable-enable ? @tr("Settings will be stored in the following folder next to wol-manager.exe. The file wol-manager.portable marks this copy as portable.")
        : root.kind == ConfirmKind.portable-disable ? @tr("Settings will be stored in AppData again. The data folder next to wol-manager.exe is kept.")
        : root.kind == ConfirmKind.portable-overwrite ? @tr("A data folder with settings already exists here. Replace it with the current settings, or keep using the existing settings?")
        : root.kind == ConfirmKind.forget-host-key ? @tr("The next time WoL Manager connects to “{0}”, it will ask you to check the host key again. Do this only if you know why the key changed, for example because the host was reinstalled.", root.req.subject)
        : @tr("“{0}” was deleted by another program while you were editing it. Save it as a new host?", root.req.subject);

    property <string> accept-text: root.kind == ConfirmKind.delete-host ? @tr("Delete")
        : root.kind == ConfirmKind.wake-all ? @tr("Wake")
        : root.kind == ConfirmKind.portable-enable ? @tr("Switch")
        : root.kind == ConfirmKind.portable-disable ? @tr("Turn off")
        : root.kind == ConfirmKind.portable-overwrite ? @tr("Replace")
        : root.kind == ConfirmKind.forget-host-key ? @tr("Forget")
        : @tr("Save as new");

    function accept(alternate: bool) {
        let r = AppState.confirm;
        AppState.confirm-open = false;
        AppState.confirm-accepted(r, alternate);
    }

    function cancel() {
        let r = AppState.confirm;
        AppState.confirm-open = false;
        AppState.confirm-cancelled(r);
    }

    close-requested => { root.cancel(); }
    // v0.2: forgetting a pinned SSH host key weakens the protection against a changed key, so
    // Enter must not do it by accident: Cancel has the initial focus there.
    init => {
        if root.kind == ConfirmKind.forget-host-key {
            cancel-button.focus();
        } else {
            accept-button.focus();
        }
    }

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 4px;
        padding-bottom: 20px;
        spacing: 12px;

        Text {
            text: root.message;
            color: Theme.text;
            wrap: word-wrap;
        }
        if root.req.path != "" : Text {
            text: root.req.path;
            font-family: Theme.mono-font;
            font-size: Theme.font-small;
            color: Theme.text-secondary;
            wrap: char-wrap;
        }
        if root.kind == ConfirmKind.portable-enable : CheckBox {
            text: @tr("Copy the current settings");
            checked: AppState.confirm.option;
            toggled => { AppState.confirm.option = self.checked; }
        }
        if root.kind == ConfirmKind.wake-all : HintText {
            text: @tr("Hosts that are already online are included.");
        }
    }

    ModalFooter {
        Rectangle { horizontal-stretch: 1; }
        accept-button := Button {
            text: root.accept-text;
            primary: true;
            min-width: 96px;
            clicked => { root.accept(false); }
        }
        if root.kind == ConfirmKind.portable-overwrite : Button {
            text: @tr("Keep existing");
            min-width: 96px;
            clicked => { root.accept(true); }
        }
        cancel-button := Button {
            text: @tr("Cancel");
            min-width: 96px;
            clicked => { root.cancel(); }
        }
    }
}

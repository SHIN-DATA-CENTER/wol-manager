msgid_plural "{0} of {n} hosts online"
msgstr[0] "{n} 台中 {0} 台がオンライン"

msgid "{0} shown"
msgstr "{0} 台を表示中"

msgid "Checking status…"
msgstr "状態を確認中…"

msgid "Last checked {0}"
msgstr "最終確認 {0}"

msgid "Not checked yet"
msgstr "まだ確認していません"

msgid "Auto check off"
msgstr "自動確認オフ"

msgid "Refresh"
msgstr "更新"

msgid "Search hosts (Ctrl+F)"
msgstr "ホストを検索 (Ctrl+F)"

msgid "Settings (Ctrl+,)"
msgstr "設定 (Ctrl+,)"

msgid "Ping (ICMP)"
msgstr "Ping (ICMP)"

msgid "TCP port"
msgstr "TCP ポート"

msgid "Don't check"
msgstr "確認しない"

msgid "Automatic (ping, then TCP)"
msgstr "自動 (Ping の後に TCP)"

msgid "Checking…"
msgstr "確認中…"

msgid "Online"
msgstr "オンライン"

msgid "Offline"
msgstr "オフライン"

msgid "Waking…"
msgstr "起動中…"

msgid "No response"
msgstr "応答なし"

msgid "Not monitored"
msgstr "監視なし"

msgid "Unknown"
msgstr "未確認"

msgid "Answered ping in {0} ms"
msgstr "Ping に {0} ms で応答しました"

msgid "Answered ping"
msgstr "Ping に応答しました"

msgid "Answered on a TCP port in {0} ms"
msgstr "TCP ポートに {0} ms で応答しました"

msgid "Answered on a TCP port"
msgstr "TCP ポートに応答しました"

msgid "The host answered the last check."
msgstr "前回の確認で応答がありました。"

msgid "The host did not answer the last check."
msgstr "前回の確認で応答がありませんでした。"

msgid "Magic packet sent. Waiting for the host to answer…"
msgstr "マジック パケットを送信しました。応答を待っています…"

msgid "The host did not answer after the magic packet was sent."
msgstr "マジック パケットの送信後、応答がありませんでした。"

msgid "Checking whether the host answers…"
msgstr "応答があるか確認しています…"

msgid "No address is set, so the status can't be checked."
msgstr "アドレスが設定されていないため、状態を確認できません。"

msgid "Status checks are turned off for this host."
msgstr "このホストの状態確認はオフになっています。"

msgid "Not checked yet."
msgstr "まだ確認していません。"

msgid "Required."
msgstr "必須です。"

msgid "Enter a MAC address such as AA:BB:CC:DD:EE:FF."
msgstr "AA:BB:CC:DD:EE:FF のような形式で MAC アドレスを入力してください。"

msgid ""
"Multicast, broadcast and all-zero addresses can't be woken. The first byte "
"must be even."
msgstr ""
"マルチキャスト、ブロードキャスト、すべて 0 のアドレスは起動の対象にできません。"
"1 バイト目は偶数にしてください。"

msgid "Enter an IPv4 address or a host name."
msgstr "IPv4 アドレスまたはホスト名を入力してください。"

msgid "Enter a port number from 1 to 65535."
msgstr "1 ～ 65535 のポート番号を入力してください。"

msgid "Enter port numbers from 1 to 65535, separated by commas."
msgstr "1 ～ 65535 のポート番号をカンマ区切りで入力してください。"

msgid "Enter up to 16 ports."
msgstr "ポートは 16 個までにしてください。"

msgid "Enter 6 bytes in hex, such as 01:23:45:67:89:AB."
msgstr "01:23:45:67:89:AB のような 6 バイトの 16 進数を入力してください。"

msgid "Enter one target per line as host or host:port."
msgstr "送信先は 1 行に 1 つずつ、ホストまたはホスト:ポートの形式で入力してください。"

msgid "A host with this name already exists."
msgstr "この名前のホストは既に存在します。"

msgid "The name can't be a MAC address."
msgstr "MAC アドレスを名前にすることはできません。"

msgid "Use 64 characters or fewer."
msgstr "64 文字以内で入力してください。"

msgid "Contains kana. Turn off the IME and type it again."
msgstr "かなが含まれています。IME をオフにして入力し直してください。"

msgid "Portable"
msgstr "ポータブル"

msgid "Custom location"
msgstr "カスタムの場所"

msgid "Standard (AppData)"
msgstr "標準 (AppData)"

msgid "Dismiss"
msgstr "閉じる"

msgid "Show WoL Manager"
msgstr "WoL Manager を表示"

msgid "Wake host"
msgstr "ホストを起動"


msgstr "バージョン {0}"

msgid "Portable"
msgstr "ポータブル"

msgid "Wake-on-LAN for Windows, with a command line tool (wolm)."
msgstr "Windows 用の Wake-on-LAN ツール (コマンドライン版 wolm 付き)"


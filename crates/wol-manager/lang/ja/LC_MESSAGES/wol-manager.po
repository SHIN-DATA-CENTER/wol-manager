msgstr "全般"

msgid "Wake & status"
msgstr "起動と状態確認"

msgid "Storage & command line"
msgstr "保存場所とコマンドライン"

msgid "Advanced"
msgstr "詳細"

msgid "Checking…"
msgstr "確認中…"

msgid "Online"
msgstr "オンライン"

msgid "Offline"
msgstr "オフライン"

msgid "Waking…"
msgstr "起動中…"

